<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
  <UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
  <AssemblyName>eFakturaViewer</AssemblyName><Version>1.1.2</Version>
  <ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>Assets/app.ico</ApplicationIcon>
  <!-- WPF a dokumentove kniznice vytvaraju cast objektov nepriamo. Trimming tu nezapinat
       bez samostatneho overenia; symboly v EXE pomahaju urcit riadok chyby bez dalsieho PDB suboru. -->
  <PublishTrimmed>false</PublishTrimmed><DebugType>embedded</DebugType>
 </PropertyGroup>
 <ItemGroup><PackageReference Include="PDFsharp-MigraDoc-WPF" Version="6.2.0" /></ItemGroup>
 <ItemGroup><EmbeddedResource Include="Assets/fmcg-properties.json" /><EmbeddedResource Include="Assets/update-public-key.xml" /><Resource Include="Assets/app.ico" /></ItemGroup>
 <ItemGroup><EmbeddedResource Include="Assets/*-notices.txt" /><EmbeddedResource Include="../../THIRD-PARTY-NOTICES.txt" Link="Assets/third-party-notices.txt" /></ItemGroup>
</Project>
